# NICARA Backend Environment Variables
# Copy this to .env and update values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=nicara_db
# DB_USER=nicara_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# ── Frontend / CORS ─────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Authentication ──────────────────────────────────
# Separate signing key for JWTs (defaults to DJANGO_SECRET_KEY)
# JWT_SIGNING_KEY=
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TIMEOUT=7200

# Seed account used by `python manage.py bootstrap_admin`
ADMIN_EMAIL=admin@nicara.design
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FIRST_NAME=NICARA
ADMIN_LAST_NAME=Admin

# ── Email (invitations & password resets) ───────────
# Defaults to the console backend in development — mail is printed to stdout.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nicara.design
