# ─────────────────────────────────────────────────────────────
# NICARA Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this to .env and update values for your environment.
#
# Generate a Django secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# ── Core ────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
DJANGO_LOG_LEVEL=WARNING

# ── Database ────────────────────────────────────────
# SQLite (default — no additional config needed):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/path/to/db.sqlite3

# MySQL (MilesWeb cPanel):
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=nicara_db
# DB_USER=nicara_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=3306

# PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nicara_db
# DB_USER=nicara_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ── Frontend / CORS ─────────────────────────────────
FRONTEND_URL=https://estimate.nicara.design
CORS_ALLOWED_ORIGINS=https://estimate.nicara.design
CSRF_TRUSTED_ORIGINS=https://estimate.nicara.design

# ── Authentication ──────────────────────────────────
# JWT_SIGNING_KEY=   # Defaults to DJANGO_SECRET_KEY
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TIMEOUT=7200

# Seed account (python manage.py bootstrap_admin)
ADMIN_EMAIL=admin@nicara.design
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FIRST_NAME=NICARA
ADMIN_LAST_NAME=Admin

# ── Email (invitations & password resets) ───────────
# Console backend in dev — SMTP in production
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nicara.design
